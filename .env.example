# SyncForge environment configuration
# Copy this file to .env and fill in the values. `npm run dev` loads it
# automatically; `docker compose` reads it for variable substitution.

# ─── Server ─────────────────────────────────────────────────────────────────
# TCP port for the Express/Socket.IO server (default: 3001)
PORT=3001

# Public URL of the browser client. Only the origin is used.
#   Development: the Vite dev server, http://localhost:5173
#   Production:  your public URL, e.g. https://syncforge.example.com
# On Render this defaults to RENDER_EXTERNAL_URL when left unset.
CLIENT_ORIGIN=http://localhost:5173

# ─── Sessions ───────────────────────────────────────────────────────────────
# Secret for signing session cookies — at least 32 characters in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_string

# ─── Redis ──────────────────────────────────────────────────────────────────
# Redis connection URL. Optional in development (state is then kept in memory
# and lost on restart); required in production.
#   redis://localhost:6379
#   redis://:password@redis:6379
#   rediss://default:password@host:6380   (TLS)
REDIS_URL=redis://localhost:6379

# Yjs updates to accumulate before a room is compacted into a snapshot.
REDIS_COMPACTION_THRESHOLD=500

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers and set its
# "Authorization callback URL" to <CLIENT_ORIGIN>/auth/github/callback:
#   http://localhost:5173/auth/github/callback      (development, via the Vite proxy)
#   https://syncforge.example.com/auth/github/callback (production)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Override the OAuth redirect URI (optional — derived from CLIENT_ORIGIN).
# GITHUB_CALLBACK_URL=https://syncforge.example.com/auth/github/callback

# Token for GitHub's REST API, used by "Import a public GitHub repository".
# Without it the server shares GitHub's anonymous limit of 60 requests/hour per
# IP — on hosted platforms that IP is shared with other apps and is often used
# up. With it the limit is 5,000/hour. A fine-grained personal access token
# with *no* permissions (public repositories, read-only) is enough:
#   https://github.com/settings/personal-access-tokens/new
# GITHUB_API_TOKEN=

# ─── Observability ──────────────────────────────────────────────────────────
# Bearer token for GET /metrics in production. Leave unset to keep /metrics
# closed (it always answers 401 in production without a token).
# METRICS_TOKEN=

# ─── Static client ──────────────────────────────────────────────────────────
# The server serves client/dist when it exists. Set SERVE_CLIENT=false when a
# CDN or separate web server hosts the client instead.
# SERVE_CLIENT=true
# CLIENT_DIST_DIR=/app/client/dist

# ─── Client (Vite dev server) ───────────────────────────────────────────────
# Where the Vite dev proxy forwards /api, /auth and /socket.io.
# SYNCFORGE_SERVER_URL=http://localhost:3001
