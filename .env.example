# SyncForge Environment Configuration
# Copy this file to .env and fill in the values before starting the server.

# ─── Server ─────────────────────────────────────────────────────────────────
# TCP port for the Express/Socket.IO server (default: 3001)
PORT=3001

# Full URL of the Vite client (default: http://localhost:5173)
# In production, set this to your actual domain, e.g. https://syncforge.example.com
CLIENT_ORIGIN=http://localhost:5173

# ─── Sessions ───────────────────────────────────────────────────────────────
# A long, randomly generated secret for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production — leaving this blank disables GitHub sign-in.
SESSION_SECRET=replace_me_with_a_long_random_string

# ─── Redis ──────────────────────────────────────────────────────────────────
# Full Redis connection URL (optional — omit to run in memory-only mode).
# Memory mode is fine for development but loses all data when the server restarts.
# Example: redis://localhost:6379
# Example (with password): redis://:yourpassword@redis:6379
REDIS_URL=redis://localhost:6379

# Number of Yjs updates to accumulate before the room is compacted into a snapshot.
# Lower values reduce memory usage; higher values reduce write amplification.
REDIS_COMPACTION_THRESHOLD=500

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the Authorization callback URL to:
#   http://localhost:3001/auth/github/callback (development)
#   https://your-domain.com/auth/github/callback (production)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Override the OAuth redirect URI (optional — computed from CLIENT_ORIGIN by default)
# GITHUB_CALLBACK_URL=https://your-domain.com/auth/github/callback

# ─── Client (Vite) ───────────────────────────────────────────────────────────
# URL of the SyncForge API server as seen from the browser client.
# Used by the Vite dev server proxy; not needed in production builds.
# SYNCFORGE_SERVER_URL=http://localhost:3001
