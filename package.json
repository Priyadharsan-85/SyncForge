{
  "name": "syncforge",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time collaborative code workspace with branches, pull requests and AI drafts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priyadharsan-85/SyncForge.git"
  },
  "engines": {
    "node": ">=22.18",
    "npm": ">=10"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace client",
    "test": "npm run test --workspaces",
    "ci": "npm run test && npm run lint && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.5.0"
    }
  }
}
